# Copy to the repo root as .env for docker compose, or to backend/.env for local runs.
RS_STAGE=dev
RS_DATABASE_URL=postgresql+asyncpg://roboscope:roboscope@localhost:5432/roboscope
RS_REDIS_URL=redis://localhost:6379/0
# Required in prod (>= 32 chars), dev has safe-for-local defaults:
# RS_JWT_SECRET=
# RS_CSRF_KEY=
RS_LOG_JSON=false
